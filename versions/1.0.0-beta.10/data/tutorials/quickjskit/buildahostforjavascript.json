uickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner#Apply-tenant-policy-deliberately":{"url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner#Apply-tenant-policy-deliberately","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Apply-tenant-policy-deliberately","title":"Apply tenant policy deliberately"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Make-the-recipe-pleasant-to-maintain":{"url":"\/tutorials\/quickjskit\/buildahostforjavascript#Make-the-recipe-pleasant-to-maintain","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#Make-the-recipe-pleasant-to-maintain","title":"Make the recipe pleasant to maintain"},"TutorialMeetingStep09.swift":{"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","fileType":"swift","content":["import Foundation","import QuickJSKit","import QuickJSKitMacros","","@JavaScriptExport","struct ProjectLead: Codable, Sendable {","    let id: String","    let name: String","}","","struct MeetingNote: Codable, Sendable {","    let project: String","    let title: String","    let actionItems: [String]","}","","struct FollowUpTask: Codable, Sendable {","    let title: String","}","","struct FollowUpPlan: Codable, Sendable {","    let title: String","    let ownerID: String?","    let tasks: [FollowUpTask]","}","","actor ProjectDirectory {","    func projectLead(for project: String) -> ProjectLead? {","        project == \"Mobile\" ? ProjectLead(id: \"ava\", name: \"Ava\") : nil","    }","}","","func makeRuntime(scriptsURL: URL) async throws -> JavaScriptRuntime {","    let runtime = try JavaScriptRuntime()","    let directory = ProjectDirectory()","    try await runtime.defineModule(\"host:workspace\") { module in","        module.type(ProjectLead.self)","        module.function(\"projectLead\", options: .init(parameterNames: [\"project\"])) {","            (project: String) async -> ProjectLead? in","            await directory.projectLead(for: project)","        }","    }","","    let recipeURL = scriptsURL.appendingPathComponent(\"follow-up.js\")","    let recipeSource = try String(contentsOf: recipeURL, encoding: .utf8)","    \/\/ Use the actual file URL in diagnostics and generated editor metadata.","    try await runtime.registerModule(","        recipeSource,","        as: \"app:follow-up\",","        sourceURL: recipeURL.absoluteString,","        typeScriptDeclarations: .init(","            \"export function plan(note: unknown): Promise<unknown>;\"","        )","    )","    \/\/ Import now so a recipe syntax or dependency error fails during setup.","    _ = try await runtime.importModule(\"app:follow-up\")","    return runtime","}","","func runRecipeAndConfigureAuthoring(","    note: MeetingNote,","    scriptsURL: URL",") async throws {","    let runtime = try await makeRuntime(scriptsURL: scriptsURL)","    let recipe = try await runtime.importModule(\"app:follow-up\")","    let makePlan = try await recipe.function(forExport: \"plan\")","    let plan: FollowUpPlan = try await makePlan.call(note)","    let declarations = try await runtime.environmentDescription()","        .typeScriptDeclarations()","    let workspace = try await runtime.environmentDescription().typeScriptWorkspace(","        options: .init(sourceGlobs: [\"Scripts\/**\/*.js\"])","    )","    try workspace.write(","        \/\/ Generated files are separate from the recipe source that authors edit.","        to: FileManager.default.temporaryDirectory","            .appendingPathComponent(\"FollowUpRecipeWorkspace\")","    )","    print(plan)","    print(declarations)","}"],"highlights":[],"identifier":"TutorialMeetingStep09.swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner":{"url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner","type":"topic","estimatedTime":"15min","title":"Run Tenant Webhook Workflows","role":"project","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner","kind":"project","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}]},"TutorialMeetingStep05.swift":{"fileName":"FollowUpCommand.swift","type":"file","fileType":"swift","syntax":"swift","content":["import QuickJSKit","","struct MeetingNote: Codable, Sendable {","    let project: String","    let title: String","    let actionItems: [String]","}","","struct ProjectLead: Codable, Sendable {","    let id: String","    let name: String","}","","struct FollowUpTask: Codable, Sendable {","    let title: String","}","","struct FollowUpPlan: Codable, Sendable {","    let title: String","    let ownerID: String?","    let tasks: [FollowUpTask]","}","","actor ProjectDirectory {","    func projectLead(for project: String) -> ProjectLead? {","        project == \"Mobile\" ? ProjectLead(id: \"ava\", name: \"Ava\") : nil","    }","}","","let recipeSource = \"\"\"","    export async function plan(note) {","        const lead = await projectLead(note.project);","        return {","            title: `Follow up: ${note.title}`,","            ownerID: lead?.id ?? null,","            tasks: note.actionItems.map(title => ({ title }))","        };","    }","    \"\"\"","","let runtime = try JavaScriptRuntime()","let directory = ProjectDirectory()","\/\/ This async binding fulfills the Promise awaited by the recipe.","try await runtime.function(\"projectLead\") { (project: String) async -> ProjectLead? in","    await directory.projectLead(for: project)","}","try await runtime.registerModule(recipeSource, as: \"app:follow-up\")","let recipe = try await runtime.importModule(\"app:follow-up\")","let makePlan = try await recipe.function(forExport: \"plan\")","let plan: FollowUpPlan = try await makePlan.call(","    MeetingNote(project: \"Mobile\", title: \"Ship the new editor\", actionItems: [])",")"],"highlights":[{"line":3},{"line":4},{"line":5},{"line":6},{"line":7},{"line":8},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":43},{"line":44},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51},{"line":52}],"identifier":"TutorialMeetingStep05.swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Ask-Swift-for-project-context":{"type":"section","title":"Ask Swift for project context","url":"\/tutorials\/quickjskit\/buildahostforjavascript#Ask-Swift-for-project-context","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#Ask-Swift-for-project-context","kind":"section","role":"pseudoSymbol"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner#Control-one-request":{"type":"section","title":"Control one request","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"kind":"section","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Control-one-request","url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner#Control-one-request","role":"pseudoSymbol"},"TutorialMeetingStep08.js":{"content":["import { projectLead } from \"host:workspace\";","","export async function plan(note) {","    const lead = await projectLead(note.project);","","    return {","        title: `Follow up: ${note.title}`,","        ownerID: lead?.id ?? null,","        tasks: note.actionItems.map(title => ({ title }))","    };","}"],"fileName":"follow-up.js","type":"file","syntax":"js","identifier":"TutorialMeetingStep08.js","highlights":[],"fileType":"js"},"TutorialMeetingStep01.swift":{"content":["import QuickJSKit","","struct MeetingNote: Codable, Sendable {","    let project: String","    let title: String","    let actionItems: [String]","}","","struct FollowUpTask: Codable, Sendable {","    let title: String","}","","struct FollowUpPlan: Codable, Sendable {","    let title: String","    let ownerID: String?","    let tasks: [FollowUpTask]","}"],"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep01.swift","highlights":[],"fileType":"swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Turn-the-rule-into-a-callable-recipe":{"type":"section","title":"Turn the rule into a callable recipe","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}],"kind":"section","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#Turn-the-rule-into-a-callable-recipe","url":"\/tutorials\/quickjskit\/buildahostforjavascript#Turn-the-rule-into-a-callable-recipe","role":"pseudoSymbol"},"doc://quickjs-kit.QuickJSKit/tutorials/table-of-contents":{"url":"\/tutorials\/table-of-contents","type":"topic","title":"Learn QuickJSKit","role":"overview","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents","kind":"overview","abstract":[{"type":"text","text":"Choose an essentials-level app integration or an advanced server"},{"type":"text","text":" "},{"type":"text","text":"workflow. Each tutorial introduces its own scenario and API boundary."}]},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#See-a-plan-make-a-round-trip":{"type":"section","title":"See a plan make a round trip","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}],"kind":"section","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#See-a-plan-make-a-round-trip","url":"\/tutorials\/quickjskit\/buildahostforjavascript#See-a-plan-make-a-round-trip","role":"pseudoSymbol"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript":{"url":"\/tutorials\/quickjskit\/buildahostforjavascript","type":"topic","estimatedTime":"15min","title":"Build a Meeting Follow-Up Command","role":"project","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript","kind":"project","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}]},"TutorialMeetingStep04.swift":{"content":["import QuickJSKit","","struct ProjectLead: Codable, Sendable {","    let id: String","    let name: String","}","","actor ProjectDirectory {","    func projectLead(for project: String) -> ProjectLead? {","        project == \"Mobile\" ? ProjectLead(id: \"ava\", name: \"Ava\") : nil","    }","}","","let runtime = try JavaScriptRuntime()","let directory = ProjectDirectory()","\/\/ An async Swift binding settles as a native JavaScript Promise.","try await runtime.function(","    \"projectLead\",","    options: .init(parameterNames: [\"project\"])",") { (project: String) async -> ProjectLead? in","    await directory.projectLead(for: project)","}"],"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep04.swift","highlights":[],"fileType":"swift"},"TutorialMeetingStep03.swift":{"content":["import QuickJSKit","","struct MeetingNote: Codable, Sendable {","    let project: String","    let title: String","    let actionItems: [String]","}","","struct FollowUpTask: Codable, Sendable {","    let title: String","}","","struct FollowUpPlan: Codable, Sendable {","    let title: String","    let ownerID: String?","    let tasks: [FollowUpTask]","}","","let recipeSource = \"\"\"","    export function plan(note) {","        return {","            title: `Follow up: ${note.title}`,","            ownerID: null,","            tasks: note.actionItems.map(title => ({ title }))","        };","    }","    \"\"\"","","let runtime = try JavaScriptRuntime()","try await runtime.registerModule(recipeSource, as: \"app:follow-up\")","let recipe = try await runtime.importModule(\"app:follow-up\")","let makePlan = try await recipe.function(forExport: \"plan\")","","\/\/ Calling a module export encodes the note and decodes a detached Swift plan.","let plan: FollowUpPlan = try await makePlan.call(","    MeetingNote(","        project: \"Mobile\",","        title: \"Ship the new editor\",","        actionItems: [\"Confirm the rollout\", \"Write release notes\"]","    )",")"],"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep03.swift","highlights":[],"fileType":"swift"},"TutorialMeetingStep02.swift":{"content":["import QuickJSKit","","struct FollowUpTask: Codable, Sendable {","    let title: String","}","","struct FollowUpPlan: Codable, Sendable {","    let title: String","    let ownerID: String?","    let tasks: [FollowUpTask]","}","","let runtime = try JavaScriptRuntime()","\/\/ The expression returns JavaScript data that matches FollowUpPlan exactly.","let preview: FollowUpPlan = try await runtime.evaluate(","    \"\"\"","    ({","        title: \"Follow up: Team sync\",","        ownerID: null,","        tasks: [{ title: \"Send the summary\" }]","    })","    \"\"\"",")","print(preview.title)"],"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep02.swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24}],"fileType":"swift"},"TutorialMeetingStep06.swift":{"content":["import QuickJSKit","import QuickJSKitMacros","","\/\/ The macro derives the JavaScript and TypeScript shape from this Swift model.","@JavaScriptExport","struct ProjectLead: Codable, Sendable {","    let id: String","    let name: String","}"],"fileName":"ProjectLead.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep06.swift","highlights":[],"fileType":"swift"},"TutorialMeetingStep07.swift":{"content":["import QuickJSKit","import QuickJSKitMacros","","@JavaScriptExport","struct ProjectLead: Codable, Sendable {","    let id: String","    let name: String","}","","actor ProjectDirectory {","    func projectLead(for project: String) -> ProjectLead? {","        project == \"Mobile\" ? ProjectLead(id: \"ava\", name: \"Ava\") : nil","    }","}","","let runtime = try JavaScriptRuntime()","let directory = ProjectDirectory()","\/\/ Only declarations in this module become recipe capabilities.","try await runtime.defineModule(\"host:workspace\") { module in","    module.type(ProjectLead.self)","    module.function(\"projectLead\", options: .init(parameterNames: [\"project\"])) {","        (project: String) async -> ProjectLead? in","        await directory.projectLead(for: project)","    }","}"],"fileName":"FollowUpCommand.swift","type":"file","syntax":"swift","identifier":"TutorialMeetingStep07.swift","highlights":[],"fileType":"swift"}}}