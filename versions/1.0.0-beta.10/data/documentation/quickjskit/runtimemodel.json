y between JavaScript values and Swift’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" "},{"type":"text","text":"types. JSON is not used as an intermediate representation."}]},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript":{"url":"\/tutorials\/quickjskit\/buildahostforjavascript","type":"topic","estimatedTime":"15min","title":"Build a Meeting Follow-Up Command","role":"project","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript","kind":"project","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}]},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptBigInt":{"url":"\/documentation\/quickjskit\/javascriptbigint","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JavaScriptBigInt","kind":"identifier"}],"title":"JavaScriptBigInt","role":"symbol","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptBigInt","abstract":[{"type":"text","text":"An arbitrary-precision JavaScript "},{"code":"bigint","type":"codeVoice"},{"text":" value.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"JavaScriptBigInt","kind":"identifier"}]},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/ErrorsAndDiagnostics":{"url":"\/documentation\/quickjskit\/errorsanddiagnostics","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"QuickJSKit keeps JavaScript failures and Swift conversion failures distinct so"},{"type":"text","text":" "},{"type":"text","text":"callers can respond at the right boundary."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/ErrorsAndDiagnostics","title":"Errors and Diagnostics"}}}