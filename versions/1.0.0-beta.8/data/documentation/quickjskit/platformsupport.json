{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/quickjskit\/platformsupport"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PlatformSupport"},"seeAlsoSections":[{"identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RunningUntrustedCode","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/OwnershipCancellationAndPerformance"],"anchor":"Operations","title":"Operations","generated":true}],"abstract":[{"type":"text","text":"Use one public API across Apple platforms, Linux, Windows, and Android."}],"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"QuickJSKit requires Swift 6.3 or newer. Apple deployment targets are macOS 13,"},{"type":"text","text":" "},{"type":"text","text":"iOS 16, tvOS 16, watchOS 9, and visionOS 1. Linux, Windows x86-64, and Android"},{"type":"text","text":" "},{"type":"text","text":"use the same Swift and C sources."}],"type":"paragraph"},{"inlineContent":[{"text":"The core library does not depend on Darwin, Glibc, WinSDK, Android APIs,","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C, or UI frameworks. A platform-specific upstream incompatibility is","type":"text"},{"text":" ","type":"text"},{"text":"isolated behind a minimal documented patch rather than changing public API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The release qualification matrix builds and tests native desktop platforms,","type":"text"},{"text":" ","type":"text"},{"text":"builds generic Apple device consumers, and builds Android AArch64 and x86-64","type":"text"},{"text":" ","type":"text"},{"text":"consumers. The portable smoke consumer exercises typed","type":"text"},{"text":" ","type":"text"},{"text":"evaluation, Codable, macros, native Promises, modules, and runtime templates.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When troubleshooting:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"verify the exact Swift 6.3 toolchain;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"verify vendored sources with "},{"type":"codeVoice","code":"Scripts\/verify-vendored-quickjs.sh"},{"type":"text","text":";"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"clean only the affected package build directory;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"confirm the target has the package’s documented minimum platform;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reproduce with the standalone "},{"code":"Integration\/PlatformSmoke","type":"codeVoice"},{"type":"text","text":" package."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"QuickJSKit"}],"title":"Platform Support"},"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"references":{"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/OwnershipCancellationAndPerformance":{"type":"topic","kind":"article","abstract":[{"text":"Choose APIs that preserve identity only when identity is needed.","type":"text"}],"role":"article","title":"Ownership, Cancellation, and Performance","url":"\/documentation\/quickjskit\/ownershipcancellationandperformance","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/OwnershipCancellationAndPerformance"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/RunningUntrustedCode":{"type":"topic","kind":"article","abstract":[{"text":"Understand the boundary between in-process resource controls and isolation.","type":"text"}],"url":"\/documentation\/quickjskit\/runninguntrustedcode","identifier":"doc:\/