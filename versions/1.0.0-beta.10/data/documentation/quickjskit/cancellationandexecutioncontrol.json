ckjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime\/Configuration-swift.struct\/maximumPendingHostCallCount","isActive":true},{"type":"text","text":" to apply"},{"type":"text","text":" "},{"type":"text","text":"backpressure before unbounded asynchronous host calls are admitted."}]},{"anchor":"Synchronous-versus-asynchronous-access","level":2,"text":"Synchronous versus asynchronous access","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synchronous runtime access form can evaluate work that completes during the"},{"type":"text","text":" "},{"type":"text","text":"current job checkpoint. It reports a pending Promise as "},{"code":".wouldSuspend","type":"codeVoice"},{"type":"text","text":" instead"},{"type":"text","text":" "},{"type":"text","text":"of blocking. Use the asynchronous form for external progress and ordinary"},{"type":"text","text":" "},{"code":"try await","type":"codeVoice"},{"type":"text","text":" behavior."}]},{"anchor":"Related-guides","level":2,"text":"Related guides","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/BindingsAndPromises"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/ErrorsAndDiagnostics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SecurityAndUntrustedCode","isActive":true}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/TypeScriptTooling":{"type":"topic","kind":"article","role":"article","url":"\/documentation\/quickjskit\/typescripttooling","title":"TypeScript Tooling","abstract":[{"type":"text","text":"Describe the exact Swift-provided JavaScript environment to TypeSc