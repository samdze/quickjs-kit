e-of-contents\/Advanced:-run-tenant-webhook-workflows"}],"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents","doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents\/$volume","doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents\/Advanced:-run-tenant-webhook-workflows"],["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]],"reference":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents"},"metadata":{"categoryPathComponent":"table-of-contents","category":"QuickJSKit Tutorials","role":"project","title":"Run Tenant Webhook Workflows"},"sections":[{"kind":"hero","content":[{"inlineContent":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"text":"Swift delivers events and keeps audit records; tenant policy chooses a","type":"text"},{"type":"text","text":" "},{"text":"destination and label for each event.","type":"text"}],"type":"paragraph"}],"chapter":"Advanced: run tenant webhook workflows","estimatedTimeInMinutes":15,"title":"Run Tenant Webhook Workflows"},{"kind":"tasks","tasks":[{"anchor":"Define-the-service-boundary","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The service has one input and one result. Keep the host surface"},{"type":"text","text":" "},{"type":"text","text":"equally small: JavaScript may ask the runtime-local audit object to"},{"text":" ","type":"text"},{"text":"record a decision, but Swift remains responsible for delivery.","type":"text"}]}]}],"stepsSection":[{"caption":[],"code":"TutorialWebhookStep01.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookModels.swift","type":"codeVoice"},{"text":", define the event and decision models,","type":"text"},{"text":" ","type":"text"},{"text":"then apply ","type":"text"},{"code":"@JavaScriptExport","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"DeliveryDecision","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"code":"DeliveryAudit","type":"codeVoice"},{"text":" actor. The macro derives their JavaScript API","type":"text"},{"text":" ","type":"text"},{"text":"and TypeScript metadata; an actor method appears as a Promise.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep02.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookEnvironment.swift","type":"codeVoice"},{"text":", write the short workflow source","type":"text"},{"text":" ","type":"text"},{"text":"beside the service code. It is application-owned and small, so","type":"text"},{"text":" ","type":"text"},{"text":"an inline source module is clearer than a separate file.","type":"text"}]}]}],"title":"Define the service boundary"},{"anchor":"Create-one-reusable-environment","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"A runtime template describes setup that every webhook runtime needs.","type":"text"},{"text":" ","type":"text"},{"text":"It stores definitions, not a JavaScript heap. Each call to","type":"text"},{"text":" ","type":"text"},{"code":"makeRuntime()","type":"codeVoice"},{"text":" creates a fresh heap and a fresh audit actor.","type":"text"}]}]}],"stepsSection":[{"caption":[],"code":"TutorialWebhookStep03.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"makeWebhookEnvironment()","type":"codeVoice"},{"text":", place the actor in a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeInstance","type":"codeVoice"},{"text":" and publish it as ","type":"text"},{"code":"audit","type":"codeVoice"},{"text":". ","type":"text"},{"code":"RuntimeObject","type":"codeVoice"},{"text":" ","type":"text"},{"text":"uses the macro-generated definition automatically, so there is","type":"text"},{"text":" ","type":"text"},{"text":"no handwritten binding list to keep in sync.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep04.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookHandler.swift","type":"codeVoice"},{"text":", make a runtime, import the workflow,","type":"text"},{"text":" ","type":"text"},{"text":"and call ","type":"text"},{"code":"decide(event)","type":"codeVoice"},{"text":". The function receives a detached","type":"text"},{"text":" ","type":"text"},{"code":"WebhookEvent","type":"codeVoice"},{"text":" and returns a detached ","type":"text"},{"code":"DeliveryDecision","type":"codeVoice"},{"text":".","type":"text"}]}]}],"title":"Create one reusable environment"},{"anchor":"Apply-tenant-policy-deliberately","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Tenant policy is the one part that a tenant team maintains, so it","type":"text"},{"text":" ","type":"text"},{"text":"lives in a JavaScript file. The host controls which files are","type":"text"},{"text":" ","type":"text"},{"text":"visible through stable ","type":"text"},{"code":"rules:","type":"codeVoice"},{"text":" specifiers.","type":"text"}]}]}],"stepsSection":[{"caption":[],"code":"TutorialWebhookStep05.js","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Rules\/acme.js","type":"codeVoice"},{"text":". It has one focused responsibility:","type":"text"},{"text":" ","type":"text"},{"text":"choose the destination for an event. It cannot access Swift or","type":"text"},{"text":" ","type":"text"},{"text":"load another module by itself.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep06.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"TenantRuleLoader.swift","type":"codeVoice"},{"text":", map the one allowed ","type":"text"},{"code":"rules:acme","type":"codeVoice"},{"text":" ","type":"text"},{"text":"specifier to that file while preserving the already registered","type":"text"},{"text":" ","type":"text"},{"text":"application workflow. A ","type":"text"},{"code":"JavaScriptModuleLoader","type":"codeVoice"},{"text":" resolves and","type":"text"},{"text":" ","type":"text"},{"text":"loads rules only after Swift accepts the request.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep07.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Replace ","type":"text"},{"code":"workflowSource","type":"codeVoice"},{"text":" and the initial template factory in","type":"text"},{"text":" ","type":"text"},{"code":"WebhookEnvironment.swift","type":"codeVoice"},{"text":". The workflow dynamically imports","type":"text"},{"text":" ","type":"text"},{"text":"the selected rule and awaits ","type":"text"},{"code":"audit.record","type":"codeVoice"},{"text":"; the revised","type":"text"},{"text":" ","type":"text"},{"text":"factory adds the loader without changing the actor or event","type":"text"},{"text":" ","type":"text"},{"text":"boundary. Swift preloads the selected rule before it calls the","type":"text"},{"text":" ","type":"text"},{"text":"workflow, so rule selection and file access stay in Swift.","type":"text"}]}]}],"title":"Apply tenant policy deliberately"},{"anchor":"Control-one-request","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"A service creates its restricted template during setup, then gives","type":"text"},{"text":" ","type":"text"},{"text":"each request a fresh runtime. A deadline belongs on the one","type":"text"},{"text":" ","type":"text"},{"code":"decide(event)","type":"codeVoice"},{"text":" call, where it limits active JavaScript execution.","type":"text"}]}]}],"stepsSection":[{"caption":[],"code":"TutorialWebhookStep08.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookHandler.swift","type":"codeVoice"},{"text":", make the restricted environment and","type":"text"},{"text":" ","type":"text"},{"text":"add a deadline to ","type":"text"},{"code":"decide(event)","type":"codeVoice"},{"text":". Swift selects and preloads","type":"text"},{"text":" ","type":"text"},{"text":"the rule, then handles the returned decision. A","type":"text"},{"text":" ","type":"text"},{"code":"JavaScriptError","type":"codeVoice"},{"text":" gives the request log a concise diagnostic.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep09.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Wrap the handler in the server’s request task. When the client","type":"text"},{"text":" ","type":"text"},{"text":"goes away, cancelling that task also interrupts its active","type":"text"},{"text":" ","type":"text"},{"text":"JavaScript call. Swift-owned work still needs its own","type":"text"},{"text":" ","type":"text"},{"text":"cancellation policy.","type":"text"}]}]}],"title":"Control one request"},{"anchor":"Prepare-service-operations","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"The template is also the single description of the JavaScript","type":"text"},{"text":" ","type":"text"},{"text":"environment for editor tooling and capacity planning. Neither","type":"text"},{"text":" ","type":"text"},{"text":"operation creates shared JavaScript state.","type":"text"}]}]}],"stepsSection":[{"caption":[],"code":"TutorialWebhookStep10.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookTooling.swift","type":"codeVoice"},{"text":", generate a workspace from the","type":"text"},{"text":" ","type":"text"},{"text":"template. The tenant rule stays a checked JavaScript file while","type":"text"},{"text":" ","type":"text"},{"text":"the generated declarations describe the Swift capabilities.","type":"text"}]}]},{"caption":[],"code":"TutorialWebhookStep11.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"WebhookServer.swift","type":"codeVoice"},{"text":", prewarm a bounded provisioner when","type":"text"},{"text":" ","type":"text"},{"text":"concurrent requests need lower startup latency. Each handed-out","type":"text"},{"text":" ","type":"text"},{"text":"runtime owns an independent heap and audit actor. Keep","type":"text"},{"text":" ","type":"text"},{"text":"capabilities narrow and rules allowlisted; use process","type":"text"},{"text":" ","type":"text"},{"text":"isolation when in-process limits are not a strong enough","type":"text"},{"text":" ","type":"text"},{"text":"boundary.","type":"text"}]}]}],"title":"Prepare service operations"}]}],"kind":"project","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner#Prepare-service-operations":{"url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner#Prepare-service-operations","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Prepare-service-operations","title":"Prepare service operations"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner#Define-the-service-boundary":{"url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner#Define-the-service-boundary","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Define-the-service-boundary","title":"Define the service boundary"},"TutorialWebhookStep07.swift":{"content":["import Foundation","import QuickJSKit","","\/\/ Replace the initial source with this policy-aware version.","let workflowSource = \"\"\"","    export async function decide(event) {","        const { destinationFor } = await import(\"rules:acme\");","        const decision = {","            destination: destinationFor(event),","            label: `${event.tenant}:${event.kind}`","        };","        await audit.record(decision);","        return decision;","    }","    \"\"\"","","\/\/ Replace makeWebhookEnvironment() with this complete factory.","func makeWebhookEnvironment(","    rulesURL: URL,","    configuration: JavaScriptRuntime.Configuration = .init()",") throws -> JavaScriptRuntimeTemplate {","    let loader = makeTenantRuleLoader(rulesURL: rulesURL)","    return try JavaScriptRuntimeTemplate(configuration: configuration) {","        RuntimeInstance(factory: { DeliveryAudit() }) {","            RuntimeObject(as: \"audit\")","        }","        ModuleLoader(loader)","        SourceModule(","            workflowSource,","            as: \"app:webhook-workflow\",","            sourceURL: \"WebhookEnvironment.workflowSource\",","            declarations: .init(","                \"export function decide(event: { tenant: string; kind: string }): Promise<{ destination: string; label: string }>;\"","            )","        )","    }","}","","\/\/ Load the host-selected rule before JavaScript evaluates dynamic import().","func loadSelectedRule(in runtime: JavaScriptRuntime) async throws {","    _ = try await runtime.importModule(\"rules:acme\")","}"],"fileName":"WebhookEnvironment.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep07.swift","highlights":[],"fileType":"swift"},"TutorialWebhookStep09.swift":{"content":["import QuickJSKit","","func handleRequest(","    _ event: WebhookEvent,","    environment: JavaScriptRuntimeTemplate",") async throws -> DeliveryDecision {","    let request = Task { try await handle(event, environment: environment) }","    return try await withTaskCancellationHandler {","        try await request.value","    } onCancel: {","        \/\/ Cancellation reaches the task that owns the runtime call.","        request.cancel()","    }","}"],"fileName":"WebhookRequest.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep09.swift","highlights":[],"fileType":"swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAProductionPluginRunner#Control-one-request":{"type":"section","title":"Control one request","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"kind":"section","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Control-one-request","url":"\/tutorials\/quickjskit\/buildaproductionpluginrunner#Control-one-request","role":"pseudoSymbol"},"TutorialWebhookStep08.swift":{"content":["import Foundation","import QuickJSKit","","func makeServiceEnvironment(rulesURL: URL) throws -> JavaScriptRuntimeTemplate {","    try makeWebhookEnvironment(","        rulesURL: rulesURL,","        configuration: .restricted","    )","}","","func handle(","    _ event: WebhookEvent,","    environment: JavaScriptRuntimeTemplate",") async throws -> DeliveryDecision {","    let runtime = try await environment.makeRuntime()","    try await loadSelectedRule(in: runtime)","    let workflow = try await runtime.importModule(\"app:webhook-workflow\")","    let decide = try await workflow.function(forExport: \"decide\")","","    do {","        \/\/ The deadline applies to this one JavaScript invocation.","        return try await decide.call(","            event,","            options: .init(timeout: .after(.milliseconds(100)))","        )","    } catch let error as JavaScriptError {","        print(\"Tenant workflow \\(error.kind): \\(error.message)\")","        throw error","    }","}"],"fileName":"WebhookHandler.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep08.swift","highlights":[],"fileType":"swift"},"TutorialWebhookStep10.swift":{"content":["import Foundation","import QuickJSKit","","func writeWebhookWorkspace(","    for environment: JavaScriptRuntimeTemplate",") throws {","    let workspace = try environment.environmentDescription().typeScriptWorkspace(","        options: .init(","            sourceGlobs: [\"Rules\/**\/*.js\"],","            checkJavaScript: true,","            includePackageJSON: true","        )","    )","    try workspace.write(","        to: FileManager.default.temporaryDirectory","            .appendingPathComponent(\"TenantWebhookWorkspace\")","    )","}"],"fileName":"WebhookTooling.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep10.swift","highlights":[],"fileType":"swift"},"doc://q