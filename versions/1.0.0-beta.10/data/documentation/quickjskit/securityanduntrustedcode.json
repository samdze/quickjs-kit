{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"kind":"article","metadata":{"modules":[{"name":"QuickJSKit"}],"roleHeading":"Article","role":"article","title":"Security and Untrusted Code"},"seeAlsoSections":[{"title":"TypeScript and operations","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptTooling","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptEnvironmentDescription","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptSchema","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptWorkspace","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/CancellationAndExecutionControl","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PerformanceAndResourceUsage","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PlatformSupport"],"generated":true,"anchor":"TypeScript-and-operations"}],"abstract":[{"type":"text","text":"QuickJSKit provides in-process resource controls. It is not an operating-system"},{"type":"text","text":" "},{"type":"text","text":"sandbox."}],"variants":[{"paths":["\/documentation\/quickjskit\/securityanduntrustedcode"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SecurityAndUntrustedCode"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Understand-the-boundary","level":2,"text":"Understand the boundary"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime\/Configuration-swift.struct\/restricted","isActive":true},{"type":"text","text":" is a conservative starting"},{"type":"text","text":" "},{"type":"text","text":"profile. It currently limits memory to 64 MiB, the JavaScript stack to 512 KiB,"},{"type":"t