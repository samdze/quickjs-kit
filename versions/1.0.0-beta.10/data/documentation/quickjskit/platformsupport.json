{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"QuickJSKit requires Swift 6.3 or newer. Apple deployment targets are macOS 13,"},{"type":"text","text":" "},{"type":"text","text":"iOS 16, tvOS 16, watchOS 9, and visionOS 1. Linux, Windows x86-64, and Android"},{"type":"text","text":" "},{"type":"text","text":"use the same Swift and C sources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core library does not depend on Darwin, Glibc, WinSDK, Android APIs,"},{"type":"text","text":" "},{"type":"text","text":"Objective-C, or UI frameworks. A platform-specific upstream incompatibility is"},{"type":"text","text":" "},{"type":"text","text":"isolated behind a minimal documented patch rather than changing public API."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The release qualification matrix builds and tests native desktop platforms,"},{"type":"text","text":" "},{"type":"text","text":"builds generic Apple device consumers, and builds Android AArch64 and x86-64"},{"type":"text","text":" "},{"type":"text","text":"consumers. The portable smoke consumer exercises typed"},{"type":"text","text":" "},{"type":"text","text":"evaluation, Codable, macros, native Promises, modules, and runtime templates."}]},{"type":"heading","anchor":"Platform-expectations","level":2,"text":"Platform expectations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core library does not depend on Darwin, Glibc, WinSDK, Android APIs,"},{"type":"text","text":" "},{"type":"text","text":"Objective-C, or UI frameworks. The public API does not vary by platform."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Windows runtimes omit JavaScript’s POSIX-thread-based "},{"type":"codeVoice","code":"Atomics"},{"type":"text","text":" intrinsic. This"},{"type":"text","text":" "},{"type":"text","text":"does not affect QuickJSKit’s actor isolation, Promises, bindings, modules, or"},{"type":"text","text":" "},{"type":"text","text":"runtime templates."}]},{"anchor":"Troubleshooting","type":"heading","level":2,"text":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When troubleshooting:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"verify the exact Swift 6.3 toolchain;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"verify vendored sources with "},{"type":"codeVoice","code":"Scripts\/verify-vendored-quickjs.sh"},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"clean only the affected package build directory;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"confirm the target has the package’s documented minimum platform;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"reproduce with the standalone "},{"type":"codeVoice","code":"Integration\/PlatformSmoke"},{"type":"text","text":" package."}],"type":"paragraph"}]}]},{"type":"heading","text":"Related guides","level":2,"anchor":"Related-guides"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeModel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SecurityAndUntrustedCode"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PerformanceAndResourceUsage"}],"type":"paragraph"}]}]}]}],"seeAlsoSections":[{"title":"TypeScript and operations","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptTooling","doc:\/\/quickjs-kit.QuickJSKit\/documentati