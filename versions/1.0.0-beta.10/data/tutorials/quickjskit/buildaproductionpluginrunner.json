rows -> DeliveryDecision {","    let runtime = try await environment.makeRuntime()","    let workflow = try await runtime.importModule(\"app:webhook-workflow\")","    let decide = try await workflow.function(forExport: \"decide\")","    return try await decide.call(event)","}"],"fileName":"WebhookHandler.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep04.swift","highlights":[],"fileType":"swift"},"TutorialWebhookStep11.swift":{"content":["import Foundation","import QuickJSKit","","func startServer(environment: JavaScriptRuntimeTemplate) async throws {","    let provisioner = try JavaScriptRuntimeProvisioner(","        template: environment,","        warmCapacity: 2","    )","    try await provisioner.warmUp()","    defer { Task { await provisioner.shutdown() } }","","    \/\/ Each runtime is transferred to one request handler.","    _ = try await provisioner.makeRuntime()","}"],"fileName":"WebhookServer.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep11.swift","highlights":[],"fileType":"swift"},"doc://quickjs-kit.QuickJSKit/tutorials/table-of-contents":{"url":"\/tutorials\/table-of-contents","type":"topic","title":"Learn QuickJSKit","role":"overview","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents","kind":"overview","abstract":[{"type":"text","text":"Choose an essentials-level app integration or an advanced server"},{"type":"text","text":" "},{"type":"text","text":"workflow. Each tutorial introduces its own scenario and API boundary."}]},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Make-the-recipe-pleasant-to-maintain":{"url":"\/tutorials\/quickjskit\/buildahostforjavascript#Make-the-recipe-pleasant-to-maintain","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-u