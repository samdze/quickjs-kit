{"kind":"article","abstract":[{"type":"text","text":"Declare one host environment and create independently isolated runtimes from it."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"QuickJSKit"}],"roleHeading":"Article","title":"Runtime Templates"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeTemplate","isActive":true},{"type":"text","text":" stores reusable Swift definitions, source"},{"type":"text","text":" "},{"type":"text","text":"modules, loaders, documentation, schemas, and optional per-runtime Swift"},{"type":"text","text":" "},{"type":"text","text":"factories. It never stores a QuickJS heap or live JavaScript value."}]},{"type":"codeListing","syntax":"swift","code":["let template = try JavaScriptRuntimeTemplate {","    Globals {","        Function(\"sum\") { (left: Int, right: Int) in","            left + right","        }","    }","","    SourceModule(","        \"export const answer = 42;\",","        as: \"app:answer\",","        declarations: .init(\"export const answer: number;\")","    )","}","","let runtime = try await template.makeRuntime()","let answer: Int = try await runtime.evaluate(\"sum(20, 22)\")"]},{"type":"paragraph","inlineContent":[{"text":"The template uses concrete Result Builder components. Standard Swift ","type":"text"},{"type":"codeVoice","code":"if"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"for"},{"text":", optional, and availability branches are flattened in lexical","type":"text"},{"text":" ","type":"text"},{"text":"order into the canonical detached provisioning definitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every created ","type":"text"},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime","type":"reference"},{"text":" has a separate QuickJS runtime, context,","type":"text"},{"text":" ","type":"text"},{"text":"module graph, Promise queue, globals, and resource limits. Create several in","type":"text"},{"text":" ","type":"text"},{"text":"parallel with Swift structured concurrency rather than sharing one heap.","type":"text"}]},{"type":"heading","text":"Prepared programs and startup","level":2,"anchor":"Prepared-programs-and-startup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptProgram"},{"type":"text","text":" when the same global script runs in several runtimes"},{"type":"text","text":" "},{"type":"text","text":"or repeatedly in one runtime:"}]},{"type":"codeListing","syntax":"swift","code":["let bootstrap = JavaScriptProgram(","    \"loadConfiguration().then(value => { globalThis.configuration = value })\",","    sourceURL: \"Scripts\/bootstrap.js\"",")","","let template = try JavaScriptRuntimeTemplate {","    Globals {","        Function(\"loadConfiguration\") { () async -> Bool in true }","    }","    SourceModule(\"export const shared = true\", as: \"app:shared\")","    SourceModule(","        \"import { shared } from 'app:shared'; export { shared }\",","        as: \"app:main\"","    )","    Prepare(bootstrap)","    Startup {","        Run(bootstrap)","        PreloadModule(\"app:shared\")","        ImportModule(\"app:main\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepared programs and registered modules keep source as their canonical form"},{"type":"text","text":" "},{"type":"text","text":"and use private compile-only artifacts as a disposable optimization. Startup"},{"type":"text","text":" "},{"type":"text","text":"actions run after all Swift definitions and per-runtime roots are installed."},{"type":"text","text":" "},{"type":"text","text":"Program Promise results and module top-level "},{"type":"codeVoice","code":"await"},{"type":"text","text":" complete before the"},{"type":"text","text":" "},{"type":"text","text":"runtime is returned."}]},{"type":"heading","text":"Prewarmed runtime supply","level":2,"anchor":"Prewarmed-runtime-supply"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeProvisioner"},{"type":"text","text":" maintains ready runtimes without weakening"},{"type":"text","text":" "},{"type":"text","text":"heap isolation:"}]},{"type":"codeListing","syntax":"swift","code":["let provisioner = try JavaScriptRuntimeProvisioner(","    template: template,","    warmCapacity: 4",")","try await provisioner.warmUp()","","let runtime = try await provisioner.makeRuntime()"]},{"type":"paragraph","inlineContent":[{"text":"The returned runtime leaves the provisioner permanently. Replenishment creates","type":"text"},{"text":" ","type":"text"},{"text":"a new independent heap; no runtime is reset, returned, or reused. Shutting down","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the provisioner affects only pending work and runtimes it has not transferred."}]},{"text":"Per-runtime Swift state","anchor":"Per-runtime-Swift-state","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use a root factory when host state must also be isolated:"}],"type":"paragraph"},{"code":["actor Storage {","    func read(_ key: String) -> String { key }","}","","let template = try JavaScriptRuntimeTemplate {","    RuntimeInstance(factory: { Storage() }) {","        RuntimeObject(as: \"storage\") {","            InstanceFunction(\"read\") { storage, key in","                try await storage.read(key)","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The root is passed only to Swift. It does not contribute a JavaScript argument"},{"type":"text","text":" "},{"type":"text","text":"or appear in generated TypeScript. One factory root can back globals, exported"},{"type":"text","text":" "},{"type":"text","text":"objects, and Swift modules, and the created runtime retains it until teardown."}],"type":"paragraph"},{"text":"Tooling without a runtime","anchor":"Tooling-without-a-runtime","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The template exposes the same detached metadata model as a configured runtime:"}],"type":"paragraph"},{"code":["let environment = try template.environmentDescription()","let declarations = try environment.typeScriptDeclarations()","let workspace = try environment.typeScriptWorkspace()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Calling this method does not create QuickJS or invoke a Swift factory.","type":"text"}],"type":"paragraph"},{"text":"Migrating from mutable template builders","anchor":"Migrating-from-mutable-template-builders","level":2,"type":"heading"},{"inlineContent":[{"text":"Template construction now uses nominal declarations rather than an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"text":"builder. Replace ","type":"text"},{"code":"template.globals","type":"codeVoice"},{"text":" with ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Globals","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"code":"globals.function","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Function","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"code":"globals.value","type":"codeVoice"},{"text":" with ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Value","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"code":"template.defineModule","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SwiftModule","isActive":true,"type":"reference"},{"text":". Replace ","type":"text"},{"code":"template.registerModule","type":"codeVoice"},{"text":" with ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SourceModule","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Per-runtime factory groups use "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeInstance","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeGlobals","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeObject","type":"reference"},{"type":"text","text":", and "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeModule","type":"reference"},{"type":"text","text":". Their members use"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/InstanceFunction","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/InstanceValue","type":"reference"},{"type":"text","text":". Prepared and startup work uses"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Prepare","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Startup","type":"reference"},{"type":"text","text":". No deprecated mutable-template aliases remain."}]},{"text":"Compilation and ownership","type":"heading","anchor":"Compilation-and-ownership","level":2},{"type":"paragraph","inlineContent":[{"text":"Registered source and prepared programs are parsed during template construction","type":"text"},{"text":" ","type":"text"},{"text":"and may receive private compile-only artifacts. Each runtime reads those","type":"text"},{"text":" ","type":"text"},{"text":"artifacts into its own heap. Module bodies remain unevaluated unless explicitly","type":"text"},{"text":" ","type":"text"},{"text":"started or imported. Source stays canonical and is used automatically if an","type":"text"},{"text":" ","type":"text"},{"text":"artifact cannot be read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Live ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptValue","type":"reference","isActive":true},{"text":" instances cannot be placed in a template because they","type":"text"},{"text":" ","type":"text"},{"text":"belong to an existing runtime. Use ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" snapshot values or create the live","type":"text"},{"text":" ","type":"text"},{"text":"value separately in each resulting runtime.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/quickjskit\/runtimetemplates"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeTemplates","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"references":{"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/InstanceFunction":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InstanceFunction","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"InstanceFunction","kind":"identifier"}],"abstract":[{"text"