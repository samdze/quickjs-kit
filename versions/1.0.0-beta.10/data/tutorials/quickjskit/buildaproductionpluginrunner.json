 event."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner#Create-one-reusable-environment","title":"Create one reusable environment"},"TutorialWebhookStep05.js":{"content":["export function destinationFor(event) {","    return event.kind === \"invoice.created\" ? \"billing\" : \"operations\";","}"],"fileName":"acme.js","type":"file","syntax":"js","identifier":"TutorialWebhookStep05.js","highlights":[],"fileType":"js"},"doc://quickjs-kit.QuickJSKit/tutorials/table-of-contents/Advanced:-run-tenant-webhook-workflows":{"url":"\/tutorials\/table-of-contents\/advanced:-run-tenant-webhook-workflows","kind":"article","type":"topic","role":"article","abstract":[],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents\/Advanced:-run-tenant-webhook-workflows","title":"Advanced: run tenant webhook workflows"},"TutorialWebhookStep01.swift":{"content":["import QuickJSKit","import QuickJSKitMacros","","struct WebhookEvent: Codable, Sendable {","    let tenant: String","    let kind: String","}","","@JavaScriptExport","struct DeliveryDecision: Codable, Sendable {","    let destination: String","    let label: String","}","","@JavaScriptExport","actor DeliveryAudit {","    \/\/\/ Records the decision that Swift will deliver.","    func record(_ decision: DeliveryDecision) -> String {","        \"Recorded \\(decision.destination)\"","    }","}"],"fileName":"WebhookModels.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep01.swift","highlights":[],"fileType":"swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Turn-the-rule-into-a-callable-recipe":{"type":"section","title":"Turn the rule into a callable recipe","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":