{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/quickjskit\/ownershipcancellationandperformance"]}],"kind":"article","identifier":{"url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/OwnershipCancellationAndPerformance","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Operations","generated":true,"title":"Operations","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RunningUntrustedCode","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PlatformSupport"]}],"abstract":[{"text":"Choose APIs that preserve identity only when identity is needed.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime","isActive":true},{"type":"text","text":" owns one independent QuickJS heap and context. Temporary C"},{"type":"text","text":" "},{"type":"text","text":"values use RAII, while long-lived objects, arrays, functions, modules, Promises,"},{"type":"text","text":" "},{"type":"text","text":"and host objects live in actor-owned registries behind pointer-free handles."},{"type":"text","text":" "},{"type":"text","text":"The registries release their values before context and runtime teardown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Codable conversion is the direct value path and avoids JSON. Live handles add"},{"type":"text","text":" "},{"type":"text","text":"registry lifetime and identity costs. Retain a "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptFunction","isActive":true},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"calling the same export repeatedly, and use "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptProgram","isActive":true},{"type":"text","text":" to avoid"},{"type":"text","text":" "},{"type":"text","text":"reparsing a known script."}],"type":"paragraph"},{"inlineContent":[{"text":"Runtime templates reuse detached definitions and private compile-only artifacts","type":"text"},{"text":" ","type":"text"},{"text":"but never share a mutable heap. ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeProvisioner","isActive":true,"type":"reference"},{"text":" can move","type":"text"},{"text":" ","type":"text"},{"text":"provisioning latency ahead of demand at the cost of memory for ready runtimes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift waiter cancellation is local. Promise producers continue for other"},{"text":" ","type":"text"},{"text":"consumers unless their binding is explicitly removed with cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"Execution timeouts cover active QuickJS work, not time suspended in Swift","type":"text"},{"text":" ","type":"text"},{"text":"bindings, loaders, or host Promise waiting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime\/resourceUsage()","isActive":true},{"type":"text","text":" and the benchmark executable to"},{"type":"text","text":" "},{"type":"text","text":"measure real workloads. Micro-optimization must not weaken ownership,"},{"type":"text","text":" "},{"type":"text","text":"isolation, deterministic cleanup, or source-canonical cache fallback."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Ownership, Cancellation, and Performance","modules":[{"name":"QuickJSKit"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"references":{