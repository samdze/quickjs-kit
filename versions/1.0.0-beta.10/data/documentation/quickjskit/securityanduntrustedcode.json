pe":"text","text":" "},{"type":"text","text":"in Swift bindings, loaders, or host Promise waiting."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending-call backpressure prevents unbounded task and Promise creation. It does"},{"type":"text","text":" "},{"type":"text","text":"not cancel work that has already been admitted."}]},{"type":"heading","anchor":"Observe-failures","level":2,"text":"Observe failures"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Install an unhandled Promise rejection handler for background work and collect"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime\/resourceUsage()","isActive":true},{"type":"text","text":". Treat resource failures, rejected"},{"type":"text","text":" "},{"type":"text","text":"Promises, loader failures, and timeouts as observable application events."}]},{"type":"heading","anchor":"Keep-dependencies-current-deliberately","level":2,"text":"Keep dependencies current deliberately"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Treat vendored QuickJS upgrades as security-sensitive dependency changes."},{"type":"text","text":" "},{"type":"text","text":"Review the upstream release, run the vendored-source verification, and qualify"},{"type":"text","text":" "},{"type":"text","text":"the supported platform matrix before shipping."}]},{"type":"heading","anchor":"Related-guides","level":2,"text":"Related guides"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/CancellationAndExecutionControl"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/ErrorsAndDiagnostics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive"