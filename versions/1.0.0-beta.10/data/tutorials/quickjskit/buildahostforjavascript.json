{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/quickjskit\/buildahostforjavascript"]}],"sections":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add a JavaScript command to a Swift notes app. The command turns a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}]}],"estimatedTimeInMinutes":15,"chapter":"Essentials: build a meeting follow-up command","kind":"hero","title":"Build a Meeting Follow-Up Command"},{"tasks":[{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"FollowUpCommand.swift"},{"type":"text","text":", define the note, task, and plan"},{"type":"text","text":" "},{"type":"text","text":"models. "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" makes the boundary explicit: Swift values in"},{"type":"text","text":" "},{"type":"text","text":"and Swift values out."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep01.swift","runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a runtime and decode one tiny JavaScript expression as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FollowUpPlan"},{"type":"text","text":". "},{"type":"codeVoice","code":"evaluate"},{"type":"text","text":" runs a script and immediately"},{"type":"text","text":" "},{"type":"text","text":"converts its result, which is ideal for a small rule with no"},{"type":"text","text":" "},{"type":"text","text":"inputs or host capabilities yet."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep02.swift","runtimePreview":null}],"anchor":"See-a-plan-make-a-round-trip","title":"See a plan make a round trip","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with the smallest useful contract. Swift owns the meeting"},{"type":"text","text":" "},{"type":"text","text":"note, preview, confirmation, and persistence. JavaScript produces"},{"type":"text","text":" "},{"type":"text","text":"only a detached follow-up plan."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"FollowUpCommand.swift"},{"type":"text","text":", declare a short "},{"type":"codeVoice","code":"recipeSource"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"register it as "},{"type":"codeVoice","code":"app:follow-up"},{"type":"text","text":", import it, and call its"},{"type":"text","text":" "},{"type":"text","text":"exported function with a "},{"type":"codeVoice","code":"MeetingNote"},{"type":"text","text":". A source module is a"},{"type":"text","text":" "},{"type":"text","text":"named JavaScript file or string; importing it gives Swift a"},{"type":"text","text":" "},{"type":"text","text":"live function handle."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep03.swift","runtimePreview":null}],"anchor":"Turn-the-rule-into-a-callable-recipe","title":"Turn the rule into a callable recipe","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first rule is short enough to keep beside the Swift command."},{"type":"text","text":" "},{"type":"text","text":"Make it a source module anyway: an exported function can accept a"},{"type":"text","text":" "},{"type":"text","text":"note, and later the same function can gain host capabilities."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the actor-backed directory and bind "},{"type":"codeVoice","code":"projectLead(project:)"},{"type":"text","text":" "},{"type":"text","text":"as a global. This temporary global keeps the next idea focused:"},{"type":"text","text":" "},{"type":"text","text":"an async Swift function appears to JavaScript as a native"},{"type":"text","text":" "},{"type":"text","text":"Promise."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep04.swift","runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the short inline recipe to await the lookup. A project"},{"type":"text","text":" "},{"type":"text","text":"without a lead is not an exceptional condition: the recipe"},{"type":"text","text":" "},{"type":"text","text":"returns an unassigned plan that the notes app can preview."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep05.swift","runtimePreview":null}],"anchor":"Ask-Swift-for-project-context","title":"Ask Swift for project context","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some teams want a default owner for every task. The project"},{"type":"text","text":" "},{"type":"text","text":"directory remains application data in Swift, while JavaScript gains"},{"type":"text","text":" "},{"type":"text","text":"one narrow asynchronous lookup. A missing lead is a normal,"},{"type":"text","text":" "},{"type":"text","text":"unassigned-plan outcome."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"@JavaScriptExport"},{"type":"text","text":" to "},{"type":"codeVoice","code":"ProjectLead"},{"type":"text","text":". The macro derives the"},{"type":"text","text":" "},{"type":"text","text":"JavaScript and TypeScript shape of a Swift type that now belongs"},{"type":"text","text":" "},{"type":"text","text":"to the recipe contract."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep06.swift","runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move the type and lookup into "},{"type":"codeVoice","code":"host:workspace"},{"type":"text","text":". A Swift module"},{"type":"text","text":" "},{"type":"text","text":"is an explicit capability list; the directory actor and all UI"},{"type":"text","text":" "},{"type":"text","text":"or persistence code remain private to Swift."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep07.swift","runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Scripts\/follow-up.js"},{"type":"text","text":" for the version that a team owns."},{"type":"text","text":" "},{"type":"text","text":"It imports "},{"type":"codeVoice","code":"projectLead"},{"type":"text","text":" from "},{"type":"codeVoice","code":"host:workspace"},{"type":"text","text":", making its"},{"type":"text","text":" "},{"type":"text","text":"dependency visible instead of relying on an ambient global."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep08.js","runtimePreview":null}],"anchor":"Give-recipe-authors-a-stable-SDK","title":"Give recipe authors a stable SDK","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inline recipe has served its purpose. A maintained team recipe"},{"type":"text","text":" "},{"type":"text","text":"deserves a file, a documented import, and editor support. Move the"},{"type":"text","text":" "},{"type":"text","text":"one host capability into "},{"type":"codeVoice","code":"host:workspace"},{"type":"text","text":"."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Load the recipe file, register its source URL for diagnostics,"},{"type":"text","text":" "},{"type":"text","text":"run "},{"type":"codeVoice","code":"plan(note)"},{"type":"text","text":", then generate declarations and a TypeScript"},{"type":"text","text":" "},{"type":"text","text":"workspace. The authoring loop is simple: edit, type-check, run,"},{"type":"text","text":" "},{"type":"text","text":"and inspect the returned plan."}]}],"caption":[],"media":null,"code":"TutorialMeetingStep09.swift","runtimePreview":null}],"anchor":"Make-the-recipe-pleasant-to-maintain","title":"Make the recipe pleasant to maintain","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The command now has a stable file-backed recipe and a small host"},{"type":"text","text":" "},{"type":"text","text":"SDK. Generate the editor files from the environment itself, so the"},{"type":"text","text":" "},{"type":"text","text":"declarations cannot drift from the runtime contract."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]}],"kind":"tasks"},{"title":"Run Tenant Webhook Workflows","abstract":[{"type":"text","text":"Build a small, reusable JavaScript environment for a webhook service."},{"type":"text","text":" "},{"type":"text","text":"Swift delivers events and keeps audit records; tenant policy chooses a"},{"type":"text","text":" "},{"type":"text","text":"destination and label for each event."}],"action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","featuredEyebrow":"Tutorial"}],"metadata":{"categoryPathComponent":"table-of-contents","title":"Build a Meeting Follow-Up Command","category":"QuickJSKit Tutorials","role":"project"},"hierarchy":{"modules":[{"reference":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents\/Essentials:-build-a-meeting-follow-up-command","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#See-a-plan-make-a-round-trip"},{"kind":"task"