{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"QuickJSKit"}],"title":"Runtime Templates","role":"article"},"seeAlsoSections":[{"title":"Build and provision runtimes","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeProvisioning","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptProgram","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Globals","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SwiftModule","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeInstance","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Startup"],"generated":true,"anchor":"Build-and-provision-runtimes"}],"abstract":[{"type":"text","text":"Declare one host environment and create independently isolated runtimes from it."}],"variants":[{"paths":["\/documentation\/quickjskit\/runtimetemplates"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeTemplates","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeTemplate"},{"type":"text","text":" stores reusable Swift definitions, source"},{"type":"text","text":" "},{"type":"text","text":"modules, loaders, documentation, schemas, and optional per-runtime Swift"},{"type":"text","text":" "},{"type":"text","text":"factories. It never stores a QuickJS heap or live JavaScript value."}]},{"syntax":"swift","code":["let template = try JavaScriptRuntimeTemplate {","    Globals {","        Function(\"sum\") { (left: Int, right: Int) in","            left + right","        }","    }","","    SourceModule(","        \"export const answer = 42;\",","        as: \"app:answer\",","        declarations: .init(\"export const answer: number;\")","    )","}","","let runtime = try await template.makeRuntime()","let answer: Int = try await runtime.evaluate(\"sum(20, 22)\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The template uses concrete Result Builder components. Standard Swift "},{"type":"codeVoice","code":"if"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"for"},{"type":"text","text":", optional, and availability branches are flattened in lexical"},{"type":"text","text":" "},{"type":"text","text":"order into the canonical detached provisioning definitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every created "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime","isActive":true},{"type":"text","text":" has a separate QuickJS runtime, context,"},{"type":"text","text":" "},{"type":"text","text":"module graph, Promise queue, globals, and resource limits. Create several in"},{"type":"text","text":" "},{"type":"text","text":"parallel with Swift structured concurrency rather than sharing one heap."}]},{"anchor":"Prepared-programs-and-startup","level":2,"text":"Prepared programs and startup","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptProgram"},{"type":"text","text":" when the same global script runs in several runtimes"},{"type":"text","text":" "},{"type":"text","text":"or repeatedly in one runtime:"}]},{"type":"codeListing","syntax":"swift","code":["let bootstrap = JavaScriptProgram(","    \"loadConfiguration().then(value => { globalThis.configuration = value })\",","    sourceURL: \"Scripts\/bootstrap.js\"",")","","let template = try JavaScriptRuntimeTemplate {","    Globals {","        Function(\"loadConfiguration\") { () async -> Bool in true }","    }","    SourceModule(\"export const shared = true\", as: \"app:shared\")","    SourceModule(","        \"import { shared } from 'app:shared'; export { shared }\",","        as: \"app:main\"","    )","    Prepare(bootstrap)","    Startup {","        Run(bootstrap)","        PreloadModule(\"app:shared\")","        ImportModule(\"app:main\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepared programs and registered modules keep source as their canonical form"},{"type":"text","text":" "},{"type":"text","text":"and use private compile-only artifacts as a disposable optimization. Startup"},{"type":"text","text":" "},{"type":"text","text":"actions run after all Swift definitions and per-runtime roots are installed."},{"type":"text","text":" "},{"type":"text","text":"Program Promise results and module top-level "},{"type":"codeVoice","code":"await"},{"type":"text","text":" complete before the"},{"type":"text","text":" "},{"type":"text","text":"runtime is returned."}]},{"type":"heading","anchor":"Prewarmed-runtime-supply","level":2,"text":"Prewarmed runtime supply"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeProvisioner","isActive":true},{"type":"text","text":" to move runtime creation ahead of demand"},{"type":"text","text":" "},{"type":"text","text":"without weakening heap isolation. See "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeProvisioning","isActive":true},{"type":"text","text":" for warm"},{"type":"text","text":" "},{"type":"text","text":"capacity, transfer, status, and shutdown behavior."}]},{"level":2,"type":"heading","text":"Per-runtime Swift state","anchor":"Per-runtime-Swift-state"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a root factory when host state must also be isolated:"}]},{"type":"codeListing","syntax":"swift","code":["actor Storage {","    func read(_ key: String) -> String { key }","}","","let template = try JavaScriptRuntimeTemplate {","    RuntimeInstance(factory: { Storage() }) {","        RuntimeObject(as: \"storage\") {","            InstanceFunction(\"read\") { storage, key in","                try await storage.read(key)","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The root is passed only to Swift. It does not contribute a JavaScript argument","type":"text"},{"text":" ","type":"text"},{"text":"or appear in generated TypeScript. One factory root can back globals, exported","type":"text"},{"text":" ","type":"text"},{"text":"objects, and Swift modules, and the created runtime retains it until teardown.","type":"text"}]},{"anchor":"Tooling-without-a-runtime","type":"heading","level":2,"text":"Tooling without a runtime"},{"type":"paragraph","inlineContent":[{"text":"The template exposes the same detached metadata model as a configured runtime:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let environment = try template.environmentDescription()","let declarations = try environment.typeScriptDeclarations()","let workspace = try environment.typeScriptWorkspace()"]},{"type":"paragraph","inlineContent":[{"text":"Calling this method does not create QuickJS or invoke a Swift factory.","type":"text"}]},{"anchor":"Publication-locations","type":"heading","level":2,"text":"Publication locations"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Globals","isActive":true,"type":"reference"},{"text":" publishes functions, values, and types on ","type":"text"},{"code":"globalThis","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SwiftModule","isActive":true,"type":"reference"},{"text":" publishes the same members in one ES module. A macro-generated","type":"text"},{"text":" ","type":"text"},{"code":"@JavaScriptExport","type":"codeVoice"},{"text":" type has no intrinsic TypeScript location, so its schema","type":"text"},{"text":" ","type":"text"},{"text":"inherits the container that publishes it. References to a separately","type":"text"},{"text":" ","type":"text"},{"text":"registered type keep that type’s own location; generated module declarations","type":"text"},{"text":" ","type":"text"},{"text":"use one local ","type":"text"},{"code":"import type","type":"codeVoice"},{"text":" block per module and deduplicate its imports.","type":"text"}]},{"anchor":"Compilation-and-ownership","type":"heading","level":2,"text":"Compilation and ownership"},{"type":"paragraph","inlineContent":[{"text":"Registered source and prepared programs are parsed during template construction","type":"text"},{"text":" ","type":"text"},{"text":"and may receive private compile-only artifacts. Each runtime reads those","type":"text"},{"text":" ","type":"text"},{"text":"artifacts into its own heap. Module bodies remain unevaluated unless explicitly","type":"text"},{"text":" ","type":"text"},{"text":"started or imported. Source stays canonical and is used automatically if an","type":"text"},{"text":" ","type":"text"},{"text":"artifact cannot be read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Live ","type":"text"},{"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptValue","isActive":true,"type":"reference"},{"text":" instances cannot be placed in a template because they","type":"text"},{"text":" ","type":"text"},{"text":"belong to an existing runtime. Use ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" snapshot values or create the live","type":"text"},{"text":" ","type":"text"},{"text":"value separately in each resulting runtime.","type":"text"}]}]}],"references":{"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptProgram":{"url":"\/documentation\/quickjskit\/javascriptprogram","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JavaScriptProgram","kind":"identifier"}],"title":"JavaScriptProgram","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An immutable JavaScript script that can be compiled once and reused."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptProgram","navigatorTitle":[{"text":"JavaScriptProgram","kind":"identifier"}]},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/RuntimeInstance":{"title":"RuntimeInstance","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeInstance","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Declares independently created Swift state for each runtime."}],"navigatorTitle":[{"kind":"identifier","text":"RuntimeInstance"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RuntimeInstance"}],"url":"\/documentation\/quickjskit\/runtimeinstance","kind":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/SwiftModule":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/quickjskit\/swiftmodule","title":"SwiftModule","navigatorTitle":[{"kind":"identifier","text":"SwiftModule"}],"abstract":[{"type":"text","text":"Declares a Swift-defined ES module in a runtime template."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SwiftModule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftModule"}]},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/Startup":{"type":"topic","title":"Startup","url":"\/documentation\/quickjskit\/startup","abstract":[{"type":"text","text":"Groups ordered actions executed after template installation."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Startup","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Startup"}],"navigatorTitle":[{"kind":"identifier","text":"Startup"}],"role":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit":{"url":"\/documentation\/quickjskit","type":"topic","title":"QuickJSKit","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Embed QuickJS in a Swift application with an actor-isolated, type-safe API."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptRuntimeTemplate":{"type":"topic","title":"JavaScriptRuntimeTemplate","url":"\/documentation\/quickjskit\/javascriptruntimetemplate","kind":"symbol","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeTemplate","abstract":[{"type":"text","text":"An immutable description of a reusable JavaScript runtime environment."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JavaScriptRuntimeTemplate","kind":"identifier"}],"navigatorTitle":[{"text":"JavaScriptRuntimeTemplate","kind":"identifier"}],"role":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptRuntimeProvisioner":{"title":"JavaScriptRuntimeProvisioner","url":"\/documentation\/quickjskit\/javascriptruntimeprovisioner","type":"topic","role":"symbol","abstract":[{"text":"Maintains a bounded supply of fully prepared, independently isolated runtimes.","type":"text"}],"navigatorTitle":[{"text":"JavaScriptRuntimeProvisioner","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JavaScriptRuntimeProvisioner","kind":"identifier"}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeProvisioner","kind":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptValue":{"title":"JavaScriptValue","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptValue","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A JavaScript value with safe Swift ownership semantics."}],"navigatorTitle":[{"kind":"identifier","text":"JavaScriptValue"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"JavaScriptValue","kind":"identifier"}],"url":"\/documentation\/quickjskit\/javascriptvalue","kind":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/JavaScriptRuntime":{"title":"JavaScriptRuntime","type":"topic","url":"\/documentation\/quickjskit\/javascriptruntime","abstract":[{"type":"text","text":"An isolated JavaScript engine and its associated object heap."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JavaScriptRuntime","kind":"identifier"}],"navigatorTitle":[{"text":"JavaScriptRuntime","kind":"identifier"}],"role":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/Globals":{"title":"Globals","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/Globals","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Declares bindings and values on the JavaScript global object."}],"navigatorTitle":[{"kind":"identifier","text":"Globals"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Globals"}],"url":"\/documentation\/quickjskit\/globals","kind":"symbol"},"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/RuntimeProvisioning":{"type":"topic","title":"Runtime Provisioning","url":"\/documentation\/quickjskit\/runtimeprovisioning","kind":"article","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeProvisioning","abstract":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeProvisioner","isActive":true},{"type":"text","text":" when a template should prepare runtimes"},{"type":"text","text":" "},{"type":"text","text":"before application demand arrives."}],"role":"article"}}}