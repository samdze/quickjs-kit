{"hierarchy":{"paths":[["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","metadata":{"role":"article","title":"Cancellation and Execution Control","modules":[{"name":"QuickJSKit"}],"roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"title":"TypeScript and operations","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptTooling","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptEnvironmentDescription","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptSchema","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/TypeScriptWorkspace","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/SecurityAndUntrustedCode","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PerformanceAndResourceUsage","doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/PlatformSupport"],"anchor":"TypeScript-and-operations"}],"abstract":[{"text":"Control active JavaScript work, Swift task cancellation, and asynchronous host","type":"text"},{"text":" ","type":"text"},{"text":"work as separate but cooperating mechanisms.","type":"text"}],"variants":[{"paths":["\/documentation\/quickjskit\/cancellationandexecutioncontrol"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/CancellationAndExecutionControl"},"primaryContentSections":[{"content":[{"anchor":"Set-an-execution-deadline","level":2,"text":"Set an execution deadline","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure a default deadline or override it for one operation:"}]},{"syntax":"swift","code":["let runtime = try JavaScriptRuntime(","    configuration: .init(","        defaultExecutionTimeout: .seconds(1)","    )",")","","let answer: Int = try await runtime.evaluate(","    \"20 + 22\",","    options: .i