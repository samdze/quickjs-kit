{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"One actor owns one heap","anchor":"One-actor-owns-one-heap"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntime","isActive":true},{"type":"text","text":" is an actor. It owns one QuickJS heap, global object,"},{"type":"text","text":" "},{"type":"text","text":"module graph, Promise queue, and live-value registry. Operations on one runtime"},{"type":"text","text":" "},{"type":"text","text":"are serialized without requiring callers to coordinate locks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Independent runtimes are independent isolation domains and can run"},{"type":"text","text":" "},{"type":"text","text":"concurrently:"}]},{"type":"codeListing","code":["let first = try JavaScriptRuntime()","let second = try JavaScriptRuntime()","","async let firstAnswer: Int = first.evaluate(\"20 + 22\")","async let secondAnswer: Int = second.evaluate(\"6 * 7\")","","let answers = try await [firstAnswer, secondAnswer]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Operations on the same runtime can be submitted from many tasks, but they"},{"type":"text","text":" "},{"type":"text","text":"still execute through that runtime actor."}]},{"level":2,"type":"heading","text":"Detached values and live values","anchor":"Detached-values-and-live-values"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detached values are Swift-owned data such as primitives, decoded models, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptBigInt","isActive":true},{"type":"text","text":". They can cross concurrency domains without engine access."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptObject","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptArray","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptFunction","isActive":true},{"type":"text","text":" are live"},{"type":"text","text":" "},{"type":"text","text":"handles. They preserve JavaScript identity and mutation, and every operation"},{"type":"text","text":" "},{"type":"text","text":"returns to the owning runtime actor. A live value retains its runtime until the"},{"type":"text","text":" "},{"type":"text","text":"handle is released."}]},{"level":2,"type":"heading","text":"Runtime affinity","anchor":"Runtime-affinity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not pass a live handle from one runtime into another:"}]},{"type":"codeListing","code":["let value: JavaScriptValue = try await first.evaluate(\"({ answer: 42 })\")","","\/\/ A cross-runtime live-value operation throws JavaScriptError.","try await second.global.set(value, forProperty: \"value\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" to create a detached snapshot when data must move between"},{"type":"text","text":" "},{"type":"text","text":"runtimes."}]},{"level":2,"type":"heading","text":"Actor reentrancy","anchor":"Actor-reentrancy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An operation passed to an asynchronous runtime access method may suspend and"},{"type":"text","text":" "},{"type":"text","text":"is reentrant at suspension points. It is not a transaction across those"},{"type":"text","text":" "},{"type":"text","text":"suspensions. Keep engine work short and perform external asynchronous work in"},{"type":"text","text":" "},{"type":"text","text":"Swift tasks or async bindings."}]},{"level":2,"type":"heading","text":"Lifetime and cleanup","anchor":"Lifetime-and-cleanup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runtime-bound values are released through their owning actor. Do not rely on a"},{"type":"text","text":" "},{"type":"text","text":"live handle’s deinitializer to perform synchronous engine work, and do not"},{"type":"text","text":" "},{"type":"text","text":"store live values in a "},{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptRuntimeTemplate","isActive":true},{"type":"text","text":". Templates contain"},{"type":"text","text":" "},{"type":"text","text":"detached definitions; each created runtime receives its own heap and live"},{"type":"text","text":" "},{"type":"text","text":"values."}]},{"level":2,"type":"heading","text":"Related guides","anchor":"Related-guides"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/EvaluationAndConversion"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/WorkingWithJavaScriptValues"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/CancellationAndExecutionControl"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeTemplates"}]}]}]}]}],"seeAlsoSections":[{"title":"Learn the core model","identifiers":["doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/table-of-contents","doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript","doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAProductionPluginRunner","doc:\/\/quickjs-kit.Q