\"rules:acme\": rulesURL.appendingPathComponent(\"acme.js\")]","    return JavaScriptModuleLoader(","        resolve: { request in","            \/\/ The template already owns this application module.","            if request.specifier == \"app:webhook-workflow\" {","                return request.specifier","            }","            \/\/ Every other allowed specifier is an explicit tenant rule.","            guard allowedRules[request.specifier] != nil else {","                throw TenantRuleError.unknownSpecifier(request.specifier)","            }","            return request.specifier","        },","        load: { request in","            guard let ruleURL = allowedRules[request.specifier] else {","                throw TenantRuleError.unknownSpecifier(request.specifier)","            }","            return JavaScriptModuleSource(","                source: try String(contentsOf: ruleURL, encoding: .utf8),","                sourceURL: ruleURL.absoluteString","            )","        }","    )","}"],"fileName":"TenantRuleLoader.swift","type":"file","syntax":"swift","identifier":"TutorialWebhookStep06.swift","highlights":[],"fileType":"swift"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript#Give-recipe-authors-a-stable-SDK":{"url":"\/tutorials\/quickjskit\/buildahostforjavascript#Give-recipe-authors-a-stable-SDK","kind":"section","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Add a JavaScript command to a Swift notes app. The command turns a"},{"type":"text","text":" "},{"type":"text","text":"structured meeting note into a typed follow-up plan that Swift can"},{"type":"text","text":" "},{"type":"text","text":"preview, confirm, and save."}],"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/tutorials\/QuickJSKit\/BuildAHostForJavaScript#Give-recipe-authors-a-stable-SDK","title":"Give recipe authors a stable SDK"},"doc://quickjs-kit.QuickJSKit/tutorials/QuickJSKit/BuildAHostForJavaScript":{"url":"\/tutorials\/quick