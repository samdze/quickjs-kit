ect","anchor":"Mutate-an-object"},{"syntax":"swift","code":["try await object.set(43, forProperty: \"answer\")","let updated: Int = try await object.value(","    forProperty: \"answer\",","    as: Int.self",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use encoded Swift values for snapshots, or assign another live value when"},{"text":" ","type":"text"},{"type":"text","text":"identity must be preserved. Values assigned to an object must belong to the"},{"type":"text","text":" "},{"type":"text","text":"same runtime."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Work with arrays","anchor":"Work-with-arrays"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptArray"},{"type":"text","text":" exposes length, indexed reads and writes, sparse slots, and"},{"type":"text","text":" "},{"type":"text","text":"append operations. Decode elements directly when the array represents data;"},{"type":"text","text":" "},{"type":"text","text":"use live operations when JavaScript mutability is part of the behavior."}],"type":"paragraph"},{"anchor":"Call-functions","type":"heading","level":2,"text":"Call functions"},{"code":["let functionValue: JavaScriptValue = try await runtime.evaluate(\"\"\"","    (name => `Hello, ${name}`)","    \"\"\")","if let function = functionValue.functionValue {","    let greeting: String = try await function.call(\"Ada\")","    print(greeting)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/JavaScriptFunction"},{"type":"text","text":" also supports heterogeneous encodable arguments,"},{"type":"text","text":" "},{"type":"text","text":"explicit result types, an explicit "},{"type":"codeVoice","code":"this"},{"type":"text","text":" receiver, and raw live arguments."}]},{"anchor":"Identity-and-lifetime","type":"heading","level":2,"text":"Identity and lifetime"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeatedly observing the same JavaScript object in one runtime produces handles"},{"type":"text","text":" "},{"type":"text","text":"with the same identity. A live handle is pointer-free and safe to pass between"},{"type":"text","text":" "},{"type":"text","text":"Swift concurrency domains, but each operation is routed back to its owning"},{"type":"text","text":" "},{"type":"text","text":"runtime actor. The handle also keeps that runtime alive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" snapshot instead of a live handle when data should outlive or"},{"type":"text","text":" "},{"type":"text","text":"move between runtimes."}]},{"type":"heading","anchor":"Related-guides","level":2,"text":"Related guides"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/RuntimeModel","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/EvaluationAndConversion","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/ErrorsAndDiagnostics","isActive":true}]}]}]}]}],"identifier":{"url":"doc:\/\/quickjs-kit.QuickJSKit\/documentation\/QuickJSKit\/WorkingWithJavaScriptValues","interfaceLanguage":"swift"},"kind":"article","references":{"doc://quickjs-kit.QuickJSKit/documentation/QuickJSKit/ErrorsAndDiagnostics":{"url":"\/documentation\/quickjskit\/errorsanddiagnostics","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"QuickJSKit keeps JavaScript failures and Swift conversion failures distinct so"},{"type":"text","text"